NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legalease
BETTER_AUTH_SECRET=change_me_super_secret_min_32_characters_long
ACCESS_TOKEN_SECRET=change_me_access_token_secret_placeholder
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=change_me_refresh_token_secret_placeholder
REFRESH_TOKEN_EXPIRES_IN=7d
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change_me_super_admin_secure_password
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
PAYMENT_CURRENCY=bdt
PAYMENT_GATEWAY_PROVIDER=STRIPE
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASS=your_sslcommerz_store_pass
SSLCOMMERZ_IS_LIVE=false
EMAIL_SENDER_SMTP_HOST=smtp.example.com
EMAIL_SENDER_SMTP_PORT=587
EMAIL_SENDER_SMTP_USER=your_smtp_user
EMAIL_SENDER_SMTP_PASS=your_smtp_password
EMAIL_SENDER_SMTP_FROM="LegalEase <no-reply@legalease.com>"
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
